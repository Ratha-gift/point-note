# dompdf writes its font cache (metrics json + a hashed copy of each font)
# into storage/fonts alongside the actual font files we ship. Ignore the
# generated cache, keep the real font.
/storage/fonts/*
!/storage/fonts/NotoSansKhmer-Regular.ttf
!/storage/fonts/NotoSansKhmer-Bold.ttf
